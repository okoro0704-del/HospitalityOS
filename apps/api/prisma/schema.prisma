  smsEnabled      Boolean  @default(false)
  pushEnabled     Boolean  @default(false)
  marketingEmail  Boolean  @default(false)
  marketingSms    Boolean  @default(false)
  marketingPush   Boolean  @default(false)
  transactionalOk Boolean  @default(true)
  metadata        Json
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([tenantId, recipientKind, recipientId])
  @@index([tenantId])
}

model NotificationChannelConfig {
  id        String   @id @default(cuid())
  tenantId  String
  channel   String
  enabled   Boolean  @default(true)
  provider  String   @default("mock")
  config    Json
  status    String   @default("active")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([tenantId, channel])
  @@index([tenantId])
}

