  type       String
  amount     Int
  currency   String
  direction  String
  status     String   @default("posted")
  metadata   Json
  createdAt  DateTime @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([paymentId])
}

model Settlement {
  id          String    @id @default(cuid())
  tenantId    String
