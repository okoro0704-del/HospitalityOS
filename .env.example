# HospitalityOS API
HOS_PORT=8800
HOS_HOST=0.0.0.0
DATABASE_URL=file:./dev.db
SESSION_SECRET=change-me-in-production-use-long-random-string
# Include Netlify (or other) guest/staff origins when deployed, e.g.
# CORS_ORIGINS=http://localhost:5180,http://localhost:5181,https://your-guest.netlify.app
CORS_ORIGINS=http://localhost:5180,http://localhost:5181
# Demo venue entry without LifeOS (guest PWA /start). Set false in locked-down prod.
ALLOW_DEMO_GUEST=true

# LifeOS experience-session integration
LIFEOS_API_URL=http://localhost:8790
LIFEOS_JWKS_URL=http://localhost:8790/.well-known/experience-keys
LIFEOS_EXPECTED_ISSUER=lifeos

# Guest PWA (required on Netlify — bake your live API URL at build time)
VITE_HOS_API_URL=http://localhost:8800
VITE_LIFEOS_API_URL=http://localhost:8790
VITE_LIFEOS_RETURN_URL=http://localhost:5174/app/discover

# Staff Web
VITE_STAFF_API_URL=http://localhost:8800
