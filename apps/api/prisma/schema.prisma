generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  businessType  String
  status        String   @default("active")
  experienceId  String?  @unique
  lifeosBusinessId String?
  logoUrl       String?
  primaryColor  String   @default("#0F766E")
  secondaryColor String  @default("#134E4A")
  accentColor   String   @default("#F59E0B")
  theme         String   @default("light")
  fontFamily    String?
  email         String?
  phone         String?
  website       String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  region        String?
  postalCode    String?
  country       String?
  operatingHours Json
  settings      Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branches      Branch[]
  modules       TenantModule[]
  customers     Customer[]
  staff         StaffMember[]
  guestSessions GuestSession[]
  staffSessions StaffSession[]
  notifications Notification[]
  auditLogs     AuditLog[]
  properties    Property[]
  amenities     Amenity[]
  resourceCategories ResourceCategory[]
  bookableResources  BookableResource[]
  bookings           Booking[]
  bookingPolicies    BookingPolicy[]
  blackoutPeriods    BlackoutPeriod[]
  holidays           Holiday[]
  waitlistEntries    WaitlistEntry[]
  catalogs           Catalog[]
  currencies         Currency[]
  salesChannels      SalesChannel[]
  promotions         Promotion[]
  coupons            Coupon[]
  taxRules           TaxRule[]
  mediaAssets        MediaAsset[]
  catalogTags        CatalogTag[]
  diningAreas        DiningArea[]
  diningMenus        DiningMenu[]
  kitchenStations    KitchenStation[]
  diningShifts       DiningShift[]
  fitnessFacilities  FitnessFacility[]
  trainers           Trainer[]
}

model Branch {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  code         String
  timezone     String   @default("UTC")
  isPrimary    Boolean  @default(false)
  status       String   @default("active")
  email        String?
  phone        String?
  addressLine1 String?
  city         String?
  region       String?
  postalCode   String?
  country      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}

model TenantModule {
  id        String   @id @default(cuid())
  tenantId  String
  moduleId  String
  enabled   Boolean  @default(true)
  config    Json
  enabledAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleId])
  @@index([tenantId])
}

model Customer {
  id           String   @id @default(cuid())
  tenantId     String
  displayName  String
  email        String?
  phone        String?
  lifeosUserId String?
  trustId      String?
  status       String   @default("active")
  preferences  Json
  loyaltyPlaceholder Json
  metadata     Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions     GuestSession[]
  reservations AccommodationReservation[]
  guestNotes   GuestNote[]
  stays        Stay[]
  bookings     Booking[]
  waitlistEntries WaitlistEntry[]

  @@unique([tenantId, lifeosUserId])
  @@index([tenantId])
  @@index([tenantId, email])
}

model StaffMember {
  id           String   @id @default(cuid())
  tenantId     String
  displayName  String
  email        String
  passwordHash String
  role         String
  branchIds    Json
  status       String   @default("active")
  lifeosStaffId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions StaffSession[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model GuestSession {
  id           String   @id @default(cuid())
  tenantId     String
  customerId   String
  tokenHash    String   @unique
  experienceId String
  lifeosJti    String
  lifeosSid    String
  scopes       Json
  displayName  String
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([lifeosJti])
}

model StaffSession {
  id        String   @id @default(cuid())
  tenantId  String
  staffId   String
  tokenHash String   @unique
  role      String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  actorKind String
  actorId   String?
  title     String
  body      String
  channel   String   @default("in_app")
  readAt    DateTime?
  metadata  Json
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  actorKind  String
  actorId    String?
  action     String
  resource   String
  resourceId String?
  metadata   Json
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([createdAt])
}

/* ── Accommodation module ───────────────────────────────────── */

model Property {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  code            String
  propertyType    String
  status          String   @default("active")
  timezone        String   @default("UTC")
  checkInTime     String   @default("15:00")
  checkOutTime    String   @default("11:00")
  email           String?
  phone           String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  region          String?
  postalCode      String?
  country         String?
  inheritBranding Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  buildings   Building[]
  floors      Floor[]
  roomTypes   RoomType[]
  rooms       Room[]
  ratePlans   RatePlan[]
  reservations AccommodationReservation[]
  stays       Stay[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Building {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId String
  name       String
  code       String
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  floors   Floor[]
  rooms    Room[]

  @@unique([propertyId, code])
  @@index([tenantId])
  @@index([propertyId])
}

model Floor {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId String
  buildingId String?
  name       String
  level      Int
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  building Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  rooms    Room[]

  @@unique([propertyId, level, buildingId])
  @@index([tenantId])
  @@index([propertyId])
}

model Amenity {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  code        String
  category    String   @default("general")
  icon        String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roomTypes RoomTypeAmenity[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model RoomType {
  id               String   @id @default(cuid())
  tenantId         String
  propertyId       String
  name             String
  code             String
  description      String?
  capacity         Int      @default(2)
  bedConfiguration String?
  baseRate         Float    @default(0)
  currency         String   @default("USD")
  photoUrls        Json
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  property     Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenities    RoomTypeAmenity[]
  rooms        Room[]
  ratePlans    RatePlan[]
  availability RoomAvailability[]
  reservations AccommodationReservation[]

  @@unique([propertyId, code])
  @@index([tenantId])
  @@index([propertyId])
}

model RoomTypeAmenity {
  id         String @id @default(cuid())
  roomTypeId String
  amenityId  String

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, amenityId])
}

model RatePlan {
  id          String   @id @default(cuid())
  tenantId    String
  propertyId  String
  roomTypeId  String?
  name        String
  code        String
  description String?
  currency    String   @default("USD")
  amount      Float
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)

  @@unique([propertyId, code])
  @@index([tenantId])
}

model Room {
  id                 String   @id @default(cuid())
  tenantId           String
  propertyId         String
  roomTypeId         String
  buildingId         String?
  floorId            String?
  number             String
  occupancyStatus    String   @default("vacant")
  housekeepingStatus String   @default("clean")
  maintenanceStatus  String   @default("available")
  notes              String?
  status             String   @default("active")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  property     Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType     RoomType            @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  building     Building?           @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  floor        Floor?              @relation(fields: [floorId], references: [id], onDelete: SetNull)
  availability RoomAvailability[]
  reservations AccommodationReservation[]
  stays        Stay[]

  @@unique([propertyId, number])
  @@index([tenantId])
  @@index([propertyId])
  @@index([roomTypeId])
}

model RoomAvailability {
  id          String   @id @default(cuid())
  tenantId    String
  roomTypeId  String
  roomId      String?
  date        DateTime
  available   Boolean  @default(true)
  inventory   Int      @default(1)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  room     Room?    @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, roomId, date])
  @@index([tenantId])
  @@index([date])
}

model AccommodationReservation {
  id               String   @id @default(cuid())
  tenantId         String
  propertyId       String
  roomTypeId       String
  roomId           String?
  customerId       String
  bookingId        String?  @unique
  status           String   @default("pending")
  checkInDate      DateTime
  checkOutDate     DateTime
  adults           Int      @default(1)
  children         Int      @default(0)
  confirmationCode String
  internalNotes    String?
  guestNotes       String?
  checkedInAt      DateTime?
  checkedOutAt     DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  property Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType RoomType            @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  room     Room?               @relation(fields: [roomId], references: [id], onDelete: SetNull)
  customer Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  booking  Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  guests   ReservationGuest[]
  timeline ReservationTimeline[]
  stay     Stay?

  @@unique([tenantId, confirmationCode])
  @@index([tenantId])
  @@index([propertyId])
  @@index([customerId])
  @@index([status])
  @@index([checkInDate, checkOutDate])
}

model ReservationGuest {
  id            String   @id @default(cuid())
  tenantId      String
  reservationId String
  fullName      String
  email         String?
  phone         String?
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())

  reservation AccommodationReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([reservationId])
}

model Stay {
  id            String   @id @default(cuid())
  tenantId      String
  reservationId String   @unique
  propertyId    String
  roomId        String
  customerId    String
  startedAt     DateTime
  endedAt       DateTime?
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reservation AccommodationReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  property    Property                 @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room        Room                     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  customer    Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([roomId])
}

model GuestNote {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  body       String
  visibility String   @default("staff")
  createdBy  String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
}

model ReservationTimeline {
  id            String   @id @default(cuid())
  tenantId      String
  reservationId String
  eventType     String
  message       String
  actorKind     String
  actorId       String?
  metadata      Json
  createdAt     DateTime @default(now())

  reservation AccommodationReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([reservationId])
}

/* ── Universal Booking & Scheduling Engine (Sprint 3) ─────── */

model ResourceCategory {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  code        String
  description String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resources BookableResource[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model BookableResource {
  id           String   @id @default(cuid())
  tenantId     String
  categoryId   String
  moduleId     String
  branchId     String?
  name         String
  code         String
  capacity     Int      @default(1)
  status       String   @default("available")
  tags         Json
  metadata     Json
  customFields Json
  sourceType   String?
  sourceId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category          ResourceCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  schedules         ResourceSchedule[]
  availabilityRules AvailabilityRule[]
  blackouts         BlackoutPeriod[]
  bookingItems      BookingItem[]
  waitlistEntries   WaitlistEntry[]
  assignments       ResourceAssignment[]
  timeSlots         TimeSlot[]

  @@unique([tenantId, code])
  @@unique([tenantId, sourceType, sourceId])
  @@index([tenantId])
  @@index([moduleId])
  @@index([categoryId])
  @@index([status])
}

model Booking {
  id               String   @id @default(cuid())
  tenantId         String
  customerId       String?
  moduleId         String
  status           String   @default("pending")
  confirmationCode String
  startsAt         DateTime
  endsAt           DateTime
  partySize        Int      @default(1)
  notes            String?
  internalNotes    String?
  checkedInAt      DateTime?
  checkedOutAt     DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items        BookingItem[]
  timeline     BookingTimeline[]
  reminders    BookingReminder[]
  conflicts    BookingConflict[]
  accommodationReservation AccommodationReservation?

  @@unique([tenantId, confirmationCode])
  @@index([tenantId])
  @@index([moduleId])
  @@index([status])
  @@index([startsAt, endsAt])
  @@index([customerId])
}

model BookingItem {
  id         String   @id @default(cuid())
  tenantId   String
  bookingId  String
  resourceId String
  quantity   Int      @default(1)
  startsAt   DateTime
  endsAt     DateTime
  status     String   @default("active")
  metadata   Json
  createdAt  DateTime @default(now())

  booking  Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resource BookableResource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([bookingId])
  @@index([resourceId])
  @@index([startsAt, endsAt])
}

model AvailabilityRule {
  id         String   @id @default(cuid())
  tenantId   String
  resourceId String?
  moduleId   String?
  name       String
  ruleType   String
  config     Json
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  resource BookableResource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([resourceId])
}

model ResourceSchedule {
  id         String   @id @default(cuid())
  tenantId   String
  resourceId String?
  moduleId   String?
  name       String
  kind       String
  timezone   String   @default("UTC")
  startsOn   DateTime?
  endsOn     DateTime?
  daysOfWeek Json
  startTime  String?
  endTime    String?
  capacity   Int?
  status     String   @default("active")
  metadata   Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  resource  BookableResource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  timeSlots TimeSlot[]

  @@index([tenantId])
  @@index([resourceId])
  @@index([kind])
}

model TimeSlot {
  id         String   @id @default(cuid())
  tenantId   String
  scheduleId String?
  resourceId String
  startsAt   DateTime
  endsAt     DateTime
  capacity   Int      @default(1)
  booked     Int      @default(0)
  status     String   @default("open")
  createdAt  DateTime @default(now())

  schedule ResourceSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  resource BookableResource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([resourceId])
  @@index([startsAt, endsAt])
}

model BlackoutPeriod {
  id         String   @id @default(cuid())
  tenantId   String
  resourceId String?
  moduleId   String?
  name       String
  reason     String?
  startsAt   DateTime
  endsAt     DateTime
  status     String   @default("active")
  createdAt  DateTime @default(now())

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resource BookableResource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([resourceId])
  @@index([startsAt, endsAt])
}

model Holiday {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  date      DateTime
  recurring Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([date])
}

model BookingPolicy {
  id                    String   @id @default(cuid())
  tenantId              String
  moduleId              String?
  name                  String
  code                  String
  minNoticeMinutes      Int      @default(0)
  maxAdvanceDays        Int      @default(365)
  cancellationDeadlineMinutes Int @default(60)
  lateArrivalGraceMinutes Int    @default(15)
  defaultDurationMinutes Int     @default(60)
  minDurationMinutes    Int      @default(15)
  maxDurationMinutes    Int      @default(1440)
  allowWaitlist         Boolean  @default(true)
  status                String   @default("active")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([moduleId])
}

model WaitlistEntry {
  id         String   @id @default(cuid())
  tenantId   String
  resourceId String?
  moduleId   String
  customerId String
  startsAt   DateTime
  endsAt     DateTime
  partySize  Int      @default(1)
  status     String   @default("waiting")
  notes      String?
  promotedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  resource BookableResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([status])
  @@index([startsAt, endsAt])
}

model BookingConflict {
  id        String   @id @default(cuid())
  tenantId  String
  bookingId String?
  code      String
  message   String
  metadata  Json
  createdAt DateTime @default(now())

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([bookingId])
}

model BookingReminder {
  id          String   @id @default(cuid())
  tenantId    String
  bookingId   String
  remindAt    DateTime
  channel     String   @default("in_app")
  status      String   @default("scheduled")
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([remindAt])
}

model ResourceAssignment {
  id         String   @id @default(cuid())
  tenantId   String
  resourceId String
  assigneeKind String
  assigneeId String
  role       String?
  startsAt   DateTime?
  endsAt     DateTime?
  status     String   @default("active")
  createdAt  DateTime @default(now())

  resource BookableResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([resourceId])
}

model BookingTimeline {
  id        String   @id @default(cuid())
  tenantId  String
  bookingId String
  eventType String
  message   String
  actorKind String
  actorId   String?
  metadata  Json
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([bookingId])
}

/* ── Universal Commerce & Catalog Engine (Sprint 4) ─────────── */

model Catalog {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  code         String
  status       String   @default("active")
  currencyCode String   @default("USD")
  settings     Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categories CatalogCategory[]
  offerings  Offering[]
  priceLists PriceList[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model CatalogCategory {
  id          String   @id @default(cuid())
  tenantId    String
  catalogId   String
  parentId    String?
  name        String
  code        String
  slug        String
  description String?
  sortOrder   Int      @default(0)
  status      String   @default("active")
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  catalog  Catalog           @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  parent   CatalogCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children CatalogCategory[] @relation("CategoryTree")
  offerings Offering[]

  @@unique([catalogId, code])
  @@index([tenantId])
  @@index([parentId])
}

model Offering {
  id               String    @id @default(cuid())
  tenantId         String
  catalogId        String
  categoryId       String?
  kind             String
  name             String
  code             String
  slug             String
  description      String?
  shortDescription String?
  status           String    @default("draft")
  visibility       String    @default("public")
  featured         Boolean   @default(false)
  basePrice        Float     @default(0)
  currencyCode     String    @default("USD")
  moduleId         String?
  tags             Json
  customAttributes Json
  metadata         Json
  sortOrder        Int       @default(0)
  seoSlug          String?
  validFrom        DateTime?
  validTo          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  catalog           Catalog            @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  category          CatalogCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  serviceDetail     ServiceDetail?
  productDetail     ProductDetail?
  packageDetail     PackageDetail?
  packageItemsAsPkg PackageItem[]      @relation("PackageParent")
  packageItemsAsChild PackageItem[]    @relation("PackageChild")
  variants          Variant[]
  optionGroups      OptionGroup[]
  modifiers         Modifier[]
  media             MediaAsset[]
  pricingRules      PricingRule[]
  addons            Addon[]            @relation("OfferingAddons")
  addonOf           Addon[]            @relation("AddonTarget")
  relationsFrom     OfferingRelation[] @relation("RelationFrom")
  relationsTo       OfferingRelation[] @relation("RelationTo")
  availabilityLinks AvailabilityLink[]
  visibilityRules   VisibilityRule[]
  discounts         Discount[]
  offeringTags      OfferingTag[]

  @@unique([tenantId, code])
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([catalogId])
  @@index([kind])
  @@index([status])
}

model ServiceDetail {
  id               String  @id @default(cuid())
  tenantId         String
  offeringId       String  @unique
  durationMinutes  Int?
  bookable         Boolean @default(true)
  metadata         Json

  offering Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model ProductDetail {
  id              String  @id @default(cuid())
  tenantId        String
  offeringId      String  @unique
  sku             String
  barcode         String?
  unit            String  @default("each")
  weight          Float?
