  offering Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([sku])
}

model PackageDetail {
  id                  String  @id @default(cuid())
  tenantId            String
  offeringId          String  @unique
  bundlePrice         Float?
  validityDays        Int?
  inheritAvailability Boolean @default(true)
