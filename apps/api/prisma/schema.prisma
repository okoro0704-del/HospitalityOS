  tenantId       String
  invoiceId      String
  sourceModule   String?
  sourceEntityId String?
  billableType   String?
  description    String
  quantity       Int     @default(1)
  unitAmount     Int
  discountAmount Int     @default(0)
  taxAmount      Int     @default(0)
  total          Int
  metadata       Json

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([sourceModule, sourceEntityId])
}

model BillableItem {
  id             String   @id @default(cuid())
  tenantId       String
  customerId     String?
  billableType   String
  sourceModule   String
  sourceEntityId String
  description    String
  currency       String
  quantity       Int      @default(1)
  unitAmount     Int
  discountAmount Int      @default(0)
  taxAmount      Int      @default(0)
  total          Int
  status         String   @default("open")
  invoiceId      String?
  metadata       Json
  createdAt      DateTime @default(now())

  @@unique([tenantId, sourceModule, sourceEntityId])
  @@index([tenantId])
  @@index([customerId])
  @@index([status])
}

model PaymentIntent {
  id             String    @id @default(cuid())
  tenantId       String
  customerId     String?
  invoiceId      String?
  amount         Int
  currency       String
  provider       String    @default("mock")
  status         String    @default("created")
  idempotencyKey String
  providerRef    String?
  scenario       String?
  metadata       Json
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  invoice  Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([invoiceId])
  @@index([status])
}

model PaymentMethod {
  id          String   @id @default(cuid())
  tenantId    String
  customerId  String?
  type        String
  provider    String   @default("mock")
  providerRef String?
  label       String?
  last4       String?
  brand       String?
  isDefault   Boolean  @default(false)
  status      String   @default("active")
  metadata    Json
  createdAt   DateTime @default(now())

  payments Payment[]

  @@index([tenantId])
  @@index([customerId])
}

model Payment {
  id              String    @id @default(cuid())
  tenantId        String
  customerId      String?
  invoiceId       String?
  intentId        String?
  paymentMethodId String?
  amount          Int
  currency        String
  provider        String    @default("mock")
  providerRef     String?
  status          String    @default("pending")
  methodType      String    @default("card")
  staffId         String?
  capturedAmount  Int       @default(0)
  refundedAmount  Int       @default(0)
  providerFee     Int       @default(0)
  netAmount       Int       @default(0)
  idempotencyKey  String?
  metadata        Json
  authorizedAt    DateTime?
  capturedAt      DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  invoice       Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  intent        PaymentIntent? @relation(fields: [intentId], references: [id], onDelete: SetNull)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  refunds       Refund[]
  receipts      Receipt[]
  transactions  BillingTransaction[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([invoiceId])
  @@index([status])
}

model Refund {
  id             String    @id @default(cuid())
  tenantId       String
  paymentId      String
  amount         Int
  currency       String
  reason         String?
  status         String    @default("requested")
  providerRef    String?
  idempotencyKey String?
  staffId        String?
  metadata       Json
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([paymentId])
  @@index([status])
}

model BillingTransaction {
  id         String   @id @default(cuid())
