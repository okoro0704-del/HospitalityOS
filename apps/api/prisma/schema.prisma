  eventId        String?
  channel        String
  status         String    @default("pending")
  provider       String    @default("mock")
  attemptCount   Int       @default(0)
  maxAttempts    Int       @default(3)
  lastError      String?
  idempotencyKey String?
  payload        Json
  sentAt         DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  notification Notification?       @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  event        NotificationEvent?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([notificationId])
  @@index([status])
}

model NotificationEvent {
  id             String   @id @default(cuid())
  tenantId       String
  eventType      String
  sourceModule   String
  sourceEntityId String?
  customerId     String?
  staffUserId    String?
  metadata       Json
  processedAt    DateTime?
  createdAt      DateTime @default(now())

  deliveries NotificationDelivery[]
  schedules  NotificationSchedule[]

  @@index([tenantId])
  @@index([eventType])
  @@index([sourceModule, sourceEntityId])
  @@index([createdAt])
}

model NotificationRecipient {
  id            String   @id @default(cuid())
  tenantId      String
  notificationId String?
  recipientKind String
  recipientId   String
  roleHint      String?
  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([recipientKind, recipientId])
  @@index([notificationId])
}

model NotificationSchedule {
