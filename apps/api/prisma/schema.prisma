  currency   String
  reason     String?
  status     String   @default("issued")
  staffId    String?
  metadata   Json
  createdAt  DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([invoiceId])
}

model Receipt {
