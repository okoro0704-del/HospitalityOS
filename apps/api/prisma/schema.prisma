/* -- Cinema & Entertainment (Sprint 9) ------------------------ */

model CinemaVenue {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  code        String
  description String?
  location    String?
  amenities   Json
  imageUrls   Json
  status      String   @default("active")
  metadata    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  screens      CinemaScreen[]
  concessions  CinemaConcession[]
  shifts       CinemaShift[]
  orders       CinemaConcessionOrder[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model CinemaScreen {
  id                 String  @id @default(cuid())
  tenantId           String
  venueId            String
  name               String
  code               String
  screenType         String  @default("standard")
  capacity           Int     @default(100)
  amenities          Json
  status             String  @default("active")
  seatingMode        String  @default("assigned")
  bookableResourceId String?
  metadata           Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  venue      CinemaVenue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  seatMap    CinemaSeatMap?
  showtimes  CinemaShowtime[]

  @@unique([venueId, code])
  @@index([tenantId])
  @@index([bookableResourceId])
}

model CinemaSeatMap {
  id        String @id @default(cuid())
  tenantId  String
  screenId  String @unique
  name      String
  status    String @default("active")

  screen   CinemaScreen          @relation(fields: [screenId], references: [id], onDelete: Cascade)
  sections CinemaSeatSection[]

  @@index([tenantId])
}

model CinemaSeatSection {
  id        String @id @default(cuid())
  tenantId  String
  seatMapId String
  name      String
  code      String
  sortOrder Int    @default(0)

  seatMap CinemaSeatMap @relation(fields: [seatMapId], references: [id], onDelete: Cascade)
  seats   CinemaSeat[]

  @@unique([seatMapId, code])
  @@index([tenantId])
}

model CinemaSeat {
  id           String  @id @default(cuid())
  tenantId     String
  sectionId    String
  label        String
  rowLabel     String?
  seatType     String  @default("standard")
  accessible   Boolean @default(false)
  premium      Boolean @default(false)
  vip          Boolean @default(false)
  status       String  @default("available")
  holdSessionId String?
  metadata     Json

  section  CinemaSeatSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  tickets  CinemaTicket[]
  holds    CinemaSeatHold[]

  @@unique([sectionId, label])
  @@index([tenantId])
  @@index([status])
}

model CinemaContent {
  id            String    @id @default(cuid())
  tenantId      String
  title         String
  code          String
  description   String?
  runtimeMinutes Int      @default(120)
  genre         String?
  category      String    @default("movie")
  rating        String    @default("PG")
  language      String?
  subtitles     String?
  releaseDate   DateTime?
  posterUrl     String?
  trailerUrl    String?
  status        String    @default("active")
  metadata      Json
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  showtimes CinemaShowtime[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([status])
}

model CinemaShowtime {
  id                 String    @id @default(cuid())
  tenantId           String
  contentId          String
  screenId           String
  startsAt           DateTime
  endsAt             DateTime
  capacity           Int       @default(100)
  soldCount          Int       @default(0)
  seatingMode        String    @default("assigned")
  status             String    @default("draft")
  bookableResourceId String?
  bookingId          String?
  publishedAt        DateTime?
  metadata           Json
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  content     CinemaContent          @relation(fields: [contentId], references: [id], onDelete: Cascade)
  screen      CinemaScreen           @relation(fields: [screenId], references: [id], onDelete: Restrict)
  ticketTypes CinemaTicketType[]
  tickets     CinemaTicket[]
  attendees   CinemaAttendee[]
  holds       CinemaSeatHold[]
  checkIns    CinemaCheckIn[]
  waitlist    CinemaWaitlist[]

  @@index([tenantId])
  @@index([contentId])
  @@index([screenId])
  @@index([startsAt])
  @@index([status])
  @@index([bookableResourceId])
}

model CinemaTicketType {
  id          String    @id @default(cuid())
  tenantId    String
  showtimeId  String
  offeringId  String?
  name        String
  code        String
  description String?
  price       Float     @default(0)
  capacity    Int       @default(100)
  soldCount   Int       @default(0)
  salesStart  DateTime?
  salesEnd    DateTime?
  accessRules Json
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  showtime CinemaShowtime  @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  tickets  CinemaTicket[]

  @@unique([showtimeId, code])
  @@index([tenantId])
  @@index([offeringId])
}

model CinemaTicket {
  id           String    @id @default(cuid())
  tenantId     String
  showtimeId   String
  ticketTypeId String
  customerId   String?
  seatId       String?
  status       String    @default("confirmed")
  holderName   String?
  holderEmail  String?
  bookedAt     DateTime  @default(now())
  cancelledAt  DateTime?
  metadata     Json

  showtime   CinemaShowtime   @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  ticketType CinemaTicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  seat       CinemaSeat?      @relation(fields: [seatId], references: [id], onDelete: SetNull)
  attendee   CinemaAttendee?
  checkIns   CinemaCheckIn[]

  @@index([tenantId])
  @@index([showtimeId])
  @@index([ticketTypeId])
  @@index([customerId])
  @@index([seatId])
  @@index([status])
}

model CinemaSeatHold {
  id          String   @id @default(cuid())
  tenantId    String
  showtimeId  String
  seatId      String
  sessionKey  String
  customerId  String?
  status      String   @default("active")
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  convertedAt DateTime?

  showtime CinemaShowtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  seat     CinemaSeat     @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([showtimeId])
  @@index([seatId])
  @@index([sessionKey])
  @@index([status])
  @@index([expiresAt])
}

model CinemaAttendee {
  id            String   @id @default(cuid())
  tenantId      String
  showtimeId    String
  ticketId      String   @unique
  customerId    String?
  displayName   String
  email         String?
  checkInStatus String   @default("not_checked_in")
  status        String   @default("registered")
  createdAt     DateTime @default(now())

  showtime CinemaShowtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  ticket   CinemaTicket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([showtimeId])
  @@index([customerId])
}

model CinemaCheckIn {
  id          String   @id @default(cuid())
  tenantId    String
  showtimeId  String
  ticketId    String
  attendeeId  String?
  status      String   @default("checked_in")
  checkedInAt DateTime @default(now())
  staffId     String?
  source      String   @default("staff")
  metadata    Json

  showtime CinemaShowtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  ticket   CinemaTicket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([showtimeId])
  @@index([ticketId])
}

model CinemaWaitlist {
  id           String    @id @default(cuid())
  tenantId     String
  showtimeId   String
  ticketTypeId String?
  customerId   String
  status       String    @default("waiting")
  notes        String?
  promotedAt   DateTime?
  createdAt    DateTime  @default(now())

  showtime CinemaShowtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([showtimeId])
  @@index([customerId])
  @@index([status])
}

model CinemaConcession {
  id         String  @id @default(cuid())
  tenantId   String
  venueId    String?
  offeringId String?
  name       String
  code       String
  description String?
  category   String  @default("snack")
  price      Float   @default(0)
  variants   Json
  modifiers  Json
  status     String  @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  venue CinemaVenue? @relation(fields: [venueId], references: [id], onDelete: SetNull)
  items CinemaConcessionOrderItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([venueId])
  @@index([offeringId])
}

model CinemaConcessionOrder {
  id          String   @id @default(cuid())
  tenantId    String
  venueId     String?
  customerId  String?
  status      String   @default("draft")
  notes       String?
  totalAmount Float    @default(0)
  submittedAt DateTime?
  readyAt     DateTime?
  collectedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  venue CinemaVenue? @relation(fields: [venueId], references: [id], onDelete: SetNull)
  items CinemaConcessionOrderItem[]

  @@index([tenantId])
  @@index([venueId])
  @@index([customerId])
  @@index([status])
}

model CinemaConcessionOrderItem {
  id            String @id @default(cuid())
  tenantId      String
  orderId       String
  concessionId  String
  quantity      Int    @default(1)
  unitPrice     Float  @default(0)
  modifiers     Json
  notes         String?

  order      CinemaConcessionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  concession CinemaConcession      @relation(fields: [concessionId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([orderId])
}

model CinemaShift {
  id        String    @id @default(cuid())
  tenantId  String
  venueId   String?
  staffId   String
  roleLabel String    @default("operations")
  startsAt  DateTime
  endsAt    DateTime?
  status    String    @default("active")
  notes     String?

  venue CinemaVenue? @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([venueId])
  @@index([staffId])
  @@index([status])
}

/* ── Operations & Inventory (Sprint 10) ──────────────────────── */

model InventoryLocation {
  id          String   @id @default(cuid())
  tenantId    String
  parentId    String?
  name        String
  code        String
  description String?
  status      String   @default("active")
  metadata    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   InventoryLocation?  @relation("LocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children InventoryLocation[] @relation("LocationTree")
  areas    InventoryArea[]
  balances InventoryBalance[]
  assets   OperationalAsset[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([parentId])
}

model InventoryArea {
  id          String  @id @default(cuid())
  tenantId    String
  locationId  String
  name        String
  code        String
  description String?
  status      String  @default("active")

  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, code])
  @@index([tenantId])
}

model InventoryCategory {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  code        String
  description String?
  status      String  @default("active")

  items InventoryItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model InventoryItem {
  id            String   @id @default(cuid())
  tenantId      String
  categoryId    String?
  name          String
  sku           String
  description   String?
  unit          String   @default("piece")
  minQuantity   Float    @default(0)
  maxQuantity   Float?
  reorderPoint  Float    @default(0)
  allowNegative Boolean  @default(false)
  imageUrl      String?
  status        String   @default("active")
  metadata      Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category     InventoryCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  balances     InventoryBalance[]
  transactions InventoryTransaction[]
  reorderRules InventoryReorderRule[]
  supplierItems InventorySupplierItem[]
  countItems   StockCountItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([categoryId])
  @@index([status])
}

model InventoryBalance {
  id         String   @id @default(cuid())
  tenantId   String
  itemId     String
  locationId String
  onHand     Float    @default(0)
  reserved   Float    @default(0)
  available  Float    @default(0)
  damaged    Float    @default(0)
  expired    Float    @default(0)
  updatedAt  DateTime @updatedAt

  item     InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, itemId, locationId])
  @@index([tenantId])
  @@index([itemId])
  @@index([locationId])
}

model InventoryTransaction {
  id            String   @id @default(cuid())
  tenantId      String
  itemId        String
  locationId    String
  type          String
  quantity      Float
  direction     String   @default("in")
  reason        String?
  referenceType String?
  referenceId   String?
  balanceAfter  Float?
  actorKind     String
  actorId       String?
  metadata      Json
  createdAt     DateTime @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([itemId])
  @@index([locationId])
  @@index([type])
  @@index([createdAt])
}

model InventoryAdjustment {
  id            String   @id @default(cuid())
  tenantId      String
  itemId        String
  locationId    String
  transactionId String?
  quantityDelta Float
  reason        String?
  actorKind     String
  actorId       String?
  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([itemId])
  @@index([transactionId])
}

model InventoryMovement {
  id               String   @id @default(cuid())
  tenantId         String
  itemId           String
  fromLocationId   String
  toLocationId     String
  quantity         Float
  reason           String?
  outTransactionId String?
  inTransactionId  String?
  actorKind        String
  actorId          String?
  createdAt        DateTime @default(now())

  @@index([tenantId])
  @@index([itemId])
  @@index([fromLocationId])
  @@index([toLocationId])
}

model StockCount {
  id          String    @id @default(cuid())
  tenantId    String
  locationId  String
  name        String
  status      String    @default("draft")
  notes       String?
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  actorId     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items StockCountItem[]

  @@index([tenantId])
  @@index([locationId])
  @@index([status])
}

model StockCountItem {
  id           String @id @default(cuid())
  tenantId     String
  stockCountId String
  itemId       String
  expectedQty  Float  @default(0)
  actualQty    Float?
  variance     Float?

  stockCount StockCount    @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([stockCountId, itemId])
  @@index([tenantId])
}

model InventoryReorderRule {
  id              String    @id @default(cuid())
  tenantId        String
  itemId          String
  locationId      String?
  reorderPoint    Float
  reorderQuantity Float
  supplierId      String?
  status          String    @default("active")
  lastAlertAt     DateTime?

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([itemId])
  @@index([status])
}

model InventorySupplier {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  code         String
  contactName  String?
  email        String?
  phone        String?
  addressLine1 String?
  city         String?
  country      String?
  notes        String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items    InventorySupplierItem[]
  requests PurchaseRequest[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model InventorySupplierItem {
  id          String @id @default(cuid())
  tenantId    String
  supplierId  String
  itemId      String
  supplierSku String?
  unitCost    Float  @default(0)
  status      String @default("active")

  supplier InventorySupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  item     InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([supplierId, itemId])
  @@index([tenantId])
}

model PurchaseRequest {
  id          String    @id @default(cuid())
  tenantId    String
  supplierId  String?
  status      String    @default("draft")
  notes       String?
  requesterId String?
  approverId  String?
  submittedAt DateTime?
  decidedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  supplier InventorySupplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items    PurchaseRequestItem[]

  @@index([tenantId])
  @@index([supplierId])
  @@index([status])
}

model PurchaseRequestItem {
  id        String @id @default(cuid())
  tenantId  String
  requestId String
  itemId    String
  quantity  Float
  unitCost  Float  @default(0)
  notes     String?

  request PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([requestId])
  @@index([itemId])
}

model OperationalAsset {
  id           String    @id @default(cuid())
  tenantId     String
  categoryId   String?
  locationId   String?
  name         String
  code         String
  serialNumber String?
  status       String    @default("available")
  purchaseDate DateTime?
  notes        String?
  metadata     Json
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    AssetCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  location    InventoryLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assignments AssetAssignment[]
  maintenance MaintenanceRecord[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([status])
  @@index([locationId])
}

model AssetCategory {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  code        String
  description String?
  status      String  @default("active")

  assets OperationalAsset[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model AssetAssignment {
  id            String    @id @default(cuid())
  tenantId      String
  assetId       String
  staffId       String?
  assigneeLabel String?
  assignedAt    DateTime  @default(now())
  returnedAt    DateTime?
  notes         String?
  status        String    @default("active")

  asset OperationalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([assetId])
}

model MaintenanceRecord {
  id         String    @id @default(cuid())
  tenantId   String
  assetId    String
  issue      String
  priority   String    @default("medium")
  status     String    @default("open")
  assigneeId String?
  notes      String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  updatedAt  DateTime  @updatedAt

