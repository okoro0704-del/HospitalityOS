  startsAt     DateTime
  endsAt       DateTime
  status       String   @default("active")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([membershipId])
}

model MembershipFreeze {
  id           String    @id @default(cuid())
  tenantId     String
  membershipId String
  reason       String?
  startsAt     DateTime
  endsAt       DateTime?
  resumedAt    DateTime?
  status       String    @default("active")
  createdAt    DateTime  @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([membershipId])
}

model MembershipBenefit {
  id       String @id @default(cuid())
  tenantId String
  planId   String
  name     String
  code     String
  config   Json
  status   String @default("active")

  plan MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, code])
  @@index([tenantId])
}

model MemberProfile {
  id             String   @id @default(cuid())
  tenantId       String
  customerId     String
  displayName    String
  emergencyContact String?
  notes          String?
  preferences    Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, customerId])
  @@index([tenantId])
}

model ClassType {
  id          String @id @default(cuid())
  tenantId    String
  name        String
  code        String
  description String?
  status      String @default("active")

  classes FitnessClass[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model FitnessClass {
  id                 String  @id @default(cuid())
  tenantId           String
  facilityId         String?
  areaId             String?
  classTypeId        String?
  offeringId         String?
  name               String
  code               String
  description        String?
  capacity           Int     @default(20)
  durationMinutes    Int     @default(60)
  membershipRequired Boolean @default(false)
  status             String  @default("active")
  metadata           Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  facility  FitnessFacility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  area      FitnessArea?     @relation(fields: [areaId], references: [id], onDelete: SetNull)
  classType ClassType?       @relation(fields: [classTypeId], references: [id], onDelete: SetNull)
  sessions  ClassSession[]
  trainers  TrainerAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model ClassSession {
  id                 String   @id @default(cuid())
  tenantId           String
  classId            String
  areaId             String?
  trainerId          String?
  bookableResourceId String?
  startsAt           DateTime
  endsAt             DateTime
  capacity           Int      @default(20)
  status             String   @default("scheduled")
  notes              String?
  createdAt          DateTime @default(now())

  fitnessClass FitnessClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  area         FitnessArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)
  trainer      Trainer?     @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  bookings     ClassBooking[]
  attendance   Attendance[]

  @@index([tenantId])
  @@index([startsAt])
  @@index([bookableResourceId])
}

model ClassBooking {
  id          String   @id @default(cuid())
  tenantId    String
  sessionId   String
  customerId  String
  bookingId   String?
  status      String   @default("confirmed")
  createdAt   DateTime @default(now())

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([sessionId])
  @@index([customerId])
  @@index([bookingId])
}

model Trainer {
  id              String   @id @default(cuid())
  tenantId        String
  staffId         String?
  customerId      String?
  displayName     String
  email           String?
  specializations Json
  bio             String?
  status          String   @default("active")
  bookableResourceId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments TrainerAssignment[]
  sessions    ClassSession[]
  training    TrainingSession[]

  @@index([tenantId])
  @@index([staffId])
}

model TrainerAssignment {
  id        String @id @default(cuid())
  tenantId  String
  trainerId String
  classId   String
  role      String @default("instructor")
  status    String @default("active")

  trainer      Trainer      @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  fitnessClass FitnessClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([trainerId, classId])
  @@index([tenantId])
}

model TrainingSession {
  id          String   @id @default(cuid())
  tenantId    String
  trainerId   String
  customerId  String
  offeringId  String?
  bookingId   String?
  startsAt    DateTime
  endsAt      DateTime
  status      String   @default("confirmed")
  notes       String?
  createdAt   DateTime @default(now())

  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([trainerId])
  @@index([customerId])
  @@index([bookingId])
}

model Attendance {
  id          String   @id @default(cuid())
  tenantId    String
  customerId  String
  sessionId   String?
  trainingId  String?
  kind        String   @default("class")
  status      String   @default("present")
  recordedAt  DateTime @default(now())
  location    String?
  notes       String?

  session ClassSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([customerId])
  @@index([sessionId])
}

model FitnessCheckIn {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  facilityId String?
  areaId     String?
  kind       String   @default("gym")
  checkedInAt DateTime @default(now())
  source     String   @default("staff")
  metadata   Json

  @@index([tenantId])
  @@index([customerId])
  @@index([checkedInAt])
}

model AccessPass {
  id           String    @id @default(cuid())
  tenantId     String
  customerId   String?
  kind         String
  offeringId   String?
  startsAt     DateTime
  expiresAt    DateTime
  allowedAreas Json
  status       String    @default("active")
  notes        String?
  createdAt    DateTime  @default(now())

  @@index([tenantId])
  @@index([customerId])
  @@index([status])
}
