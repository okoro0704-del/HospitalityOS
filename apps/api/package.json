{
  "name": "@hospitalityos/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:push:dev": "prisma db push",
    "db:push:pg": "node scripts/pg-push.mjs",
    "db:generate:pg": "node scripts/pg-generate.mjs",
    "db:migrate:pg": "node scripts/pg-migrate.mjs",
    "db:migrate:deploy": "node scripts/pg-migrate.mjs --deploy",
    "db:migrate:status": "node scripts/pg-migrate.mjs --status",
    "db:backup:pg": "node scripts/pg-backup.mjs",
    "db:seed": "tsx --env-file=../../.env prisma/seed.ts",
    "test": "node scripts/run-tests-serial.mjs",
    "test:parallel": "tsx --env-file=../../.env --test --test-concurrency=1 test/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@hospitalityos/shared": "*",
    "@hospitalityos/trustid-protocol": "*",
    "@lifeos/shared": "*",
    "@prisma/client": "^6.5.0",
    "fastify": "^5.2.1",
    "jose": "^6.2.7",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "embedded-postgres": "^18.4.0-beta.17",
    "pg": "^8.22.0",
    "typescript": "^5.8.2"
  },
  "prisma": {
    "seed": "tsx --env-file=../../.env prisma/seed.ts"
  }
}
